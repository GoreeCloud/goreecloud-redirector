{
  "manifest_version": 3,
  "name": "GoreeCloud Redirector",
  "version": "0.2.0",
  "description": "Privacy-first URL redirects for GoreeCloud services. Includes Google Keep to GoreeCloud Memos by default.",
  "homepage_url": "https://github.com/GoreeCloud/goreecloud-redirector",
  "icons": {
    "16": "icons/redirector-16.png",
    "32": "icons/redirector-32.png",
    "48": "icons/redirector-48.png",
    "64": "icons/redirector-64.png",
    "96": "icons/redirector-96.png",
    "128": "icons/redirector-128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "https://keep.google.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "goreecloud_builtin",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "GoreeCloud Redirector",
    "default_icon": "icons/redirector.svg",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "redirector@goreecloud.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
